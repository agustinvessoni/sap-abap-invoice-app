projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZAV_C_INVOICE alias Invoice
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZAV_C_ITEM alias Item
{
  use update;
  use delete;

  use association _Invoice { with draft; }
}